{
  "name": "antiqum-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test src/museums/*.test.ts src/louvre/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file=.env.local --import tsx scripts/setupDatabase.ts",
    "museums:sync": "node --env-file=.env.local --import tsx scripts/syncMuseums.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
